{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing": {
      "root": "apps/landing",
      "framework": "nextjs"
    },
    "patient": {
      "root": "apps/patient",
      "framework": "nextjs"
    },
    "doctor": {
      "root": "apps/doctor",
      "framework": "nextjs"
    },
    "health_worker": {
      "root": "apps/health-worker",
      "framework": "nextjs"
    },
    "hospital": {
      "root": "apps/hospital",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": {
        "service": "landing"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "landing"
      }
    },
    {
      "source": "/patient/:path*",
      "destination": {
        "service": "patient"
      }
    },
    {
      "source": "/patient",
      "destination": {
        "service": "patient"
      }
    },
    {
      "source": "/doctor/:path*",
      "destination": {
        "service": "doctor"
      }
    },
    {
      "source": "/doctor",
      "destination": {
        "service": "doctor"
      }
    },
    {
      "source": "/health-worker/:path*",
      "destination": {
        "service": "health_worker"
      }
    },
    {
      "source": "/health-worker",
      "destination": {
        "service": "health_worker"
      }
    },
    {
      "source": "/hospital-admin/:path*",
      "destination": {
        "service": "hospital"
      }
    },
    {
      "source": "/hospital-admin",
      "destination": {
        "service": "hospital"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "landing"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
