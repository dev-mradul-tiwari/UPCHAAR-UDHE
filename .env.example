# ---- Database ----
POSTGRES_USER=upchaar
POSTGRES_PASSWORD=upchaar_dev_password
POSTGRES_DB=upchaar
DATABASE_URL=postgresql://upchaar:upchaar_dev_password@localhost:5432/upchaar?schema=public

# ---- API ----
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-me-with-a-long-random-string
