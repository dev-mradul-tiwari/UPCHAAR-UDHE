# ---- Database ----
POSTGRES_USER=upchaar
POSTGRES_PASSWORD=upchaar_dev_password
POSTGRES_DB=upchaar
DATABASE_URL=postgresql://upchaar:upchaar_dev_password@localhost:5432/upchaar?schema=public

# ---- API ----
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- AI (optional; AI routes return 503 when unset) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Frontends ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1

# ---- SMS Notifications ----
# Provider options:
#  - "console": Prints formatted SMS in terminal (default for offline dev - 0 credits used)
#  - "jio": Uses Jio SIM Android Gateway endpoint
#  - "twilio": Uses Twilio REST API
#  - "auto": Primary Twilio -> Failover Jio SIM Gateway
SMS_PROVIDER=console
JIO_GATEWAY_URL=http://192.168.29.171:8082
JIO_GATEWAY_TOKEN=f3b83d8b-f4b7-4cc4-8bba-fadefcab109c
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
